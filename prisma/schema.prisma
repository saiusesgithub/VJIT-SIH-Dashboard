generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HackathonStatus {
  UPCOMING
  LIVE
  COMPLETED
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  ADMIN
  JUDGE
  TEAM
}

model Hackathon {
  id                String             @id
  name              String
  shortName         String
  academicYear      String
  status            HackathonStatus    @default(UPCOMING)
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  venues            Venue[]
  problemStatements ProblemStatement[]
  teams             Team[]
  reviewRounds      ReviewRound[]
}

model Venue {
  id                String             @id
  hackathonId       String
  code              String
  name              String
  roomNumber        String
  building          String?
  displayOrder      Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  hackathon         Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  problemStatements ProblemStatement[]
  teams             Team[]
  judgeAssignments  VenueJudge[]

  @@unique([hackathonId, code])
  @@unique([hackathonId, displayOrder])
  @@index([hackathonId])
}

model Judge {
  id               String       @id
  name             String
  designation      String
  department       String
  email            String?
  phone            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  venueAssignments VenueJudge[]
  reviews          Review[]
  userProfile      UserProfile?
}

model VenueJudge {
  id        String   @id
  venueId   String
  judgeId   String
  isPrimary Boolean  @default(false)
  pinHash   String?
  pinLookup String?  @unique
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  judge     Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([venueId, judgeId])
  @@index([venueId, isPrimary])
  @@index([judgeId])
}

model ProblemStatement {
  id           String    @id
  hackathonId  String
  venueId      String
  code         String
  title        String
  description  String
  organization String?
  theme        String?
  category     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hackathon    Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  teams        Team[]

  @@unique([hackathonId, code])
  @@index([hackathonId])
  @@index([venueId])
}

model Team {
  id                 String           @id
  hackathonId        String
  venueId            String
  problemStatementId String
  teamCode           String
  teamName           String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  hackathon          Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  venue              Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  problemStatement   ProblemStatement @relation(fields: [problemStatementId], references: [id], onDelete: Restrict)
  members            TeamMember[]
  reviews            Review[]
  userProfile        UserProfile?

  @@unique([hackathonId, teamCode])
  @@index([venueId])
  @@index([problemStatementId])
  @@index([teamCode])
}

model TeamMember {
  id         String   @id
  teamId     String
  name       String
  rollNumber String
  department String
  year       Int
  role       String?
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, rollNumber])
  @@index([teamId])
}

model ReviewRound {
  id           String    @id
  hackathonId  String
  roundNumber  Int
  name         String
  description  String?
  displayOrder Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hackathon    Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  rubrics      Rubric[]
  reviews      Review[]

  @@unique([hackathonId, roundNumber])
  @@unique([hackathonId, displayOrder])
  @@index([hackathonId])
}

model Rubric {
  id            String        @id
  reviewRoundId String
  name          String
  description   String?
  maxMarks      Decimal       @db.Decimal(6, 2)
  displayOrder  Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reviewRound   ReviewRound   @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  scores        ReviewScore[]

  @@unique([reviewRoundId, displayOrder])
  @@index([reviewRoundId])
}

model Review {
  id             String        @id
  teamId         String
  reviewRoundId  String
  judgeId        String?
  status         ReviewStatus  @default(PENDING)
  startedAt      DateTime?
  submittedAt    DateTime?
  generalRemarks String?
  improvements   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviewRound    ReviewRound   @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  judge          Judge?        @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  scores         ReviewScore[]

  @@unique([teamId, reviewRoundId])
  @@index([reviewRoundId, status])
  @@index([judgeId])
  @@index([startedAt])
}

model ReviewScore {
  id        String   @id
  reviewId  String
  rubricId  String
  score     Decimal  @db.Decimal(6, 2)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rubric    Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@unique([reviewId, rubricId])
  @@index([reviewId])
  @@index([rubricId])
}

model UserProfile {
  id           String   @id
  authProvider String?
  authUserId   String?
  role         UserRole
  teamId       String?  @unique
  judgeId      String?  @unique
  name         String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  judge        Judge?   @relation(fields: [judgeId], references: [id], onDelete: SetNull)

  @@unique([authProvider, authUserId])
  @@index([role])
}
