# Pooled Neon connection used by the application at runtime.
DATABASE_URL=

# Direct Neon connection used by Prisma CLI migrations and seeding.
DATABASE_URL_UNPOOLED=

# Optional alias for the direct migration connection.
DIRECT_URL=

# Shared faculty PIN. Do not use a NEXT_PUBLIC_ prefix.
ADMIN_PIN=

# At least 32 characters; use a randomly generated value in production.
ADMIN_SESSION_SECRET=

# Stable keyed lookup secret for judge PINs; use the same value for app instances sharing one database.
JUDGE_PIN_LOOKUP_SECRET=

# Stable keyed lookup secret for team access codes. Never expose with NEXT_PUBLIC_.
TEAM_ACCESS_LOOKUP_SECRET=
